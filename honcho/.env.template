# ============================================================
# Honcho v3 — конфиг памяти агента (шаблон).
#
# Это ШАБЛОН: конкретные значения подставляет configure.sh
# (из stack.config / переменных окружения) и пишет honcho/.env.
# Плейсхолдеры __...__ в готовом honcho/.env быть не должно.
#
# LLM памяти (deriver/dialectic/summary/dream) — удалённый, OpenAI-совместимый:
#   MiniMax (по умолчанию) — https://api.minimax.io/v1, модель MiniMax-M3.
#   Ключ: HONCHO_LLM_API_KEY в stack.config → honcho/fetch-llm-key.sh → "local".
#
# Эмбеддинги — локальный llama.cpp :8095 (модель и размерность из stack.config):
#   bge-m3  — качественнее (590 МБ, 1024-dim, pooling cls)
#   minilm  — для маломощных ПК (126 МБ, 384-dim, pooling mean)
#   Внутри docker хост = host.docker.internal.
# ============================================================

# --- auth: локально без токенов ---
AUTH_USE_AUTH=false
LLM_OPENAI_API_KEY=__HONCHO_LLM_API_KEY__

# --- эмбеддинги: llama.cpp :8095 (внутри docker — host.docker.internal) ---
EMBED_MESSAGES=true
EMBEDDING_VECTOR_DIMENSIONS=__EMBED_DIM__
EMBEDDING_MAX_INPUT_TOKENS=__EMBED_MAX_INPUT_TOKENS__
EMBEDDING_MAX_TOKENS_PER_REQUEST=__EMBED_MAX_TOKENS_PER_REQUEST__
EMBEDDING_MODEL_CONFIG__TRANSPORT=openai
EMBEDDING_MODEL_CONFIG__MODEL=__EMBED_MODEL_NAME__
EMBEDDING_MODEL_CONFIG__MAX_BATCH_SIZE=4
EMBEDDING_MODEL_CONFIG__OVERRIDES__BASE_URL=http://host.docker.internal:8095/v1
EMBEDDING_MODEL_CONFIG__OVERRIDES__API_KEY_ENV=EMBEDDING_API_KEY
EMBEDDING_API_KEY=local

# --- LLM памяти (единая точка настройки) ---
HONCHO_LLM_BASE_URL=__HONCHO_LLM_BASE_URL__
HONCHO_LLM_MODEL=__HONCHO_LLM_MODEL__

# --- deriver ---
DERIVER_MODEL_CONFIG__TRANSPORT=openai
DERIVER_MODEL_CONFIG__STRUCTURED_OUTPUT_MODE=json_object
DERIVER_MODEL_CONFIG__MODEL=__HONCHO_LLM_MODEL__
DERIVER_MODEL_CONFIG__OVERRIDES__BASE_URL=__HONCHO_LLM_BASE_URL__
DERIVER_MODEL_CONFIG__OVERRIDES__API_KEY_ENV=LLM_OPENAI_API_KEY
# Персональный стек: обрабатывать каждое сообщение сразу (иначе deriver копит
# representation-батч до 512 токенов / 30 минут) — память появляется мгновенно.
DERIVER_FLUSH_ENABLED=true
DERIVER_REPRESENTATION_BATCH_WORK_UNIT_TARGET_TOKENS=0
DERIVER_POLLING_STARTUP_JITTER_SECONDS=2

# --- summary ---
SUMMARY_MODEL_CONFIG__TRANSPORT=openai
SUMMARY_MODEL_CONFIG__STRUCTURED_OUTPUT_MODE=json_object
SUMMARY_MODEL_CONFIG__MODEL=__HONCHO_LLM_MODEL__
SUMMARY_MODEL_CONFIG__OVERRIDES__BASE_URL=__HONCHO_LLM_BASE_URL__
SUMMARY_MODEL_CONFIG__OVERRIDES__API_KEY_ENV=LLM_OPENAI_API_KEY

# --- dream (дедукция/индукция) ---
DREAM_DEDUCTION_MODEL_CONFIG__TRANSPORT=openai
DREAM_DEDUCTION_MODEL_CONFIG__STRUCTURED_OUTPUT_MODE=json_object
DREAM_DEDUCTION_MODEL_CONFIG__MODEL=__HONCHO_LLM_MODEL__
DREAM_DEDUCTION_MODEL_CONFIG__OVERRIDES__BASE_URL=__HONCHO_LLM_BASE_URL__
DREAM_DEDUCTION_MODEL_CONFIG__OVERRIDES__API_KEY_ENV=LLM_OPENAI_API_KEY

DREAM_INDUCTION_MODEL_CONFIG__TRANSPORT=openai
DREAM_INDUCTION_MODEL_CONFIG__STRUCTURED_OUTPUT_MODE=json_object
DREAM_INDUCTION_MODEL_CONFIG__MODEL=__HONCHO_LLM_MODEL__
DREAM_INDUCTION_MODEL_CONFIG__OVERRIDES__BASE_URL=__HONCHO_LLM_BASE_URL__
DREAM_INDUCTION_MODEL_CONFIG__OVERRIDES__API_KEY_ENV=LLM_OPENAI_API_KEY

# --- dialectic (уровни скрупулёзности) ---
DIALECTIC_LEVELS__minimal__MODEL_CONFIG__TRANSPORT=openai
DIALECTIC_LEVELS__minimal__MODEL_CONFIG__STRUCTURED_OUTPUT_MODE=json_object
DIALECTIC_LEVELS__minimal__MODEL_CONFIG__MODEL=__HONCHO_LLM_MODEL__
DIALECTIC_LEVELS__minimal__MODEL_CONFIG__OVERRIDES__BASE_URL=__HONCHO_LLM_BASE_URL__
DIALECTIC_LEVELS__minimal__MODEL_CONFIG__OVERRIDES__API_KEY_ENV=LLM_OPENAI_API_KEY

DIALECTIC_LEVELS__low__MODEL_CONFIG__TRANSPORT=openai
DIALECTIC_LEVELS__low__MODEL_CONFIG__STRUCTURED_OUTPUT_MODE=json_object
DIALECTIC_LEVELS__low__MODEL_CONFIG__MODEL=__HONCHO_LLM_MODEL__
DIALECTIC_LEVELS__low__MODEL_CONFIG__OVERRIDES__BASE_URL=__HONCHO_LLM_BASE_URL__
DIALECTIC_LEVELS__low__MODEL_CONFIG__OVERRIDES__API_KEY_ENV=LLM_OPENAI_API_KEY

DIALECTIC_LEVELS__medium__MODEL_CONFIG__TRANSPORT=openai
DIALECTIC_LEVELS__medium__MODEL_CONFIG__STRUCTURED_OUTPUT_MODE=json_object
DIALECTIC_LEVELS__medium__MODEL_CONFIG__MODEL=__HONCHO_LLM_MODEL__
DIALECTIC_LEVELS__medium__MODEL_CONFIG__OVERRIDES__BASE_URL=__HONCHO_LLM_BASE_URL__
DIALECTIC_LEVELS__medium__MODEL_CONFIG__OVERRIDES__API_KEY_ENV=LLM_OPENAI_API_KEY

DIALECTIC_LEVELS__high__MODEL_CONFIG__TRANSPORT=openai
DIALECTIC_LEVELS__high__MODEL_CONFIG__STRUCTURED_OUTPUT_MODE=json_object
DIALECTIC_LEVELS__high__MODEL_CONFIG__MODEL=__HONCHO_LLM_MODEL__
DIALECTIC_LEVELS__high__MODEL_CONFIG__OVERRIDES__BASE_URL=__HONCHO_LLM_BASE_URL__
DIALECTIC_LEVELS__high__MODEL_CONFIG__OVERRIDES__API_KEY_ENV=LLM_OPENAI_API_KEY

DIALECTIC_LEVELS__max__MODEL_CONFIG__TRANSPORT=openai
DIALECTIC_LEVELS__max__MODEL_CONFIG__STRUCTURED_OUTPUT_MODE=json_object
DIALECTIC_LEVELS__max__MODEL_CONFIG__MODEL=__HONCHO_LLM_MODEL__
DIALECTIC_LEVELS__max__MODEL_CONFIG__OVERRIDES__BASE_URL=__HONCHO_LLM_BASE_URL__
DIALECTIC_LEVELS__max__MODEL_CONFIG__OVERRIDES__API_KEY_ENV=LLM_OPENAI_API_KEY

# --- прочее ---
CACHE_ENABLED=true
CACHE_URL=redis://redis:6379/0?suppress=true
VECTOR_STORE_TYPE=pgvector
SENTRY_ENABLED=false
METRICS_ENABLED=false
TELEMETRY_ENABLED=false
