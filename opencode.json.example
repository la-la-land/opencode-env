{
  // ============================================================
  // opencode-env — справочный шаблон конфигурации opencode (V2).
  //
  // НЕ копируется автоматически: рабочий конфиг генерирует
  // ./configure.sh из stack.config (реальные пути подставляются сам).
  // Этот файл нужен только для ручной установки без configure.sh.
  //
  // Перед использованием замени плейсхолдер /PATH/TO/opencode-env
  // на реальный абсолютный путь, где лежит клон репозитория.
  // Модельно-независимый: локальная (llama.cpp :1234), удалённая
  // OpenAI-совместимая, или несколько сразу. Выбор модели в рантайме:
  // /models в opencode (суб-агенты по умолчанию наследуют её).
  // ============================================================
  "$schema": "https://opencode.ai/config.json",

  "model": "local/coder",

  "providers": {
    // --- Локальный инференс (llama.cpp): start.sh main на этом ПК ---
    "local": {
      "name": "Local llama.cpp (:1234)",
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "http://127.0.0.1:1234/v1",
        "apiKey": "local"
      },
      "models": {
        "coder": {
          "modelID": "local-coder",
          "name": "Gemma 4 12B it (256K)",
          "capabilities": { "tools": true, "input": ["text"], "output": ["text"] },
          "limit": { "context": 262144, "output": 65536 }
        }
      }
    },

    // --- Удалённая модель (пример: любая OpenAI-совместимая) ---
    // Раскомментируй и задай REMOTE_BASE_URL / REMOTE_API_KEY / REMOTE_MODEL,
    // либо скопируй этот блок в свой конфиг с реальными значениями.
    // "remote": {
    //   "name": "Remote OpenAI-compatible",
    //   "package": "@opencode/ai/providers/openai-compatible",
    //   "settings": {
    //     "baseURL": "{env:REMOTE_BASE_URL}",
    //     "apiKey": "{env:REMOTE_API_KEY}"
    //   },
    //   "models": {
    //     "main": {
    //       "modelID": "{env:REMOTE_MODEL}",
    //       "limit": { "context": 200000, "output": 32768 }
    //     }
    //   }
    // }
  },

  // --- Суб-агенты: модель НЕ задана = наследуют модель текущей сессии.
  // Задай конкретную (например "remote/main"), чтобы закрепить за агентом
  // свою. ВАЖНО: модель у агента можно и не трогать вообще —
  // наследование решает задачу.
  "agents": {
    "explore":      { "model": "local/coder" },
    "general":      { "model": "local/coder" },
    "implementer":  { "model": "local/coder" },
    "reviewer":     { "model": "local/coder" }
  },

  "mcp": {
    "servers": {
      // --- RAG по коду: чанки и лексика в sqlite, ВЕКТОРА в Qdrant :6333,
      // коллекция rag_<проект>. Активный проект — по рабочей директории.
      "rag": {
        "type": "local",
        "command": ["node", "/PATH/TO/opencode-env/mcp/rag-server.mjs"],
        "enabled": true
      },

      // --- Honcho: пер-проектная память (workspace project-<имя>).
      // Требует запущенный honcho :8000 (make honcho).
      "honcho": {
        "type": "local",
        "command": ["node", "/PATH/TO/opencode-env/mcp/honcho-server.mjs"],
        "environment": { "HONCHO_BASE_URL": "http://127.0.0.1:8000" },
        "enabled": true
      },

      // --- Vision: локальная мультимодальная модель или удалённая.
      // Если используешь удалённую (например MiniMax/OpenAI), задай env.
      "vision": {
        "type": "local",
        "command": ["node", "/PATH/TO/opencode-env/mcp/vision-server.mjs"],
        "environment": {
          "OPENAI_BASE_URL": "{env:VISION_BASE_URL}",
          "OPENAI_API_KEY": "{env:VISION_API_KEY}",
          "VISION_MODEL": "{env:VISION_MODEL}"
        },
        "enabled": false
      },

      // --- Браузерная автоматизация ---
      "chrome-devtools": {
        "type": "local",
        "command": [
          "npx", "-y", "chrome-devtools-mcp@latest",
          "--headless",
          "--no-sandbox",
          "--chromeArg=--no-sandbox",
          "--chromeArg=--disable-setuid-sandbox",
          "--chromeArg=--disable-dev-shm-usage",
          "--chromeArg=--disable-gpu",
          "--no-usage-statistics",
          "--no-performance-crux",
          "--isolated",
          "--executable-path", "{env:CHROME_PATH}"
        ],
        "enabled": true
      },
      "playwright": {
        "type": "local",
        "command": [
          "npx", "-y", "@playwright/mcp@latest",
          "--headless",
          "--no-sandbox",
          "--browser", "chromium",
          "--isolated"
        ],
        "enabled": true
      }
    }
  },

  "experimental": {
    "mcp_timeout": 300000
  }
}