# ============================================================
# opencode-env / stack.config — настройки MCP-стеков.
# Меняй значения и запусти: ./configure.sh (или make config).
# Всё остальное (opencode.json, honcho/.env) перегенерируется автоматически.
#
# Чего здесь НЕТ (и не будет):
#   - модели по умолчанию — opencode сам даёт список моделей в /models,
#     выбираешь прямо в сессии, суб-агенты наследуют её;
#   - удалённые провайдеры — добавляются нативно: opencode /providers,
#     auth login, provider add;
#   - модели суб-агентов — наследуют модель сессии.
# ============================================================

# --- локальная LLM (llama.cpp :1234) — только если поставил: make model-gemma ---
LOCAL_LLM_BASE_URL=http://127.0.0.1:1234/v1
LOCAL_LLM_MODEL=local-coder

# --- vision-MCP (скриншоты, описание картинок) ---
# Пусто = vision выключен. Включить: ./configure.sh set-vision <model> <base_url> [api_key]
VISION_MODEL=
VISION_BASE_URL=
VISION_API_KEY=

# --- honcho (память агента): LLM для deriver/dialectic/summary ---
# Пусто = берётся из LOCAL_LLM_* (адрес внутри docker-контейнеров: host.docker.internal).
HONCHO_LLM_BASE_URL=http://host.docker.internal:1234/v1
HONCHO_LLM_MODEL=local-coder

# --- браузер (chrome-devtools MCP) ---
CHROME_PATH=/usr/bin/google-chrome